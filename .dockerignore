# Keep the image small and free of local state.
.git
.gitignore
.github
node_modules
vendor
public/build
public/storage
storage/app/public
storage/app/private
storage/logs/*.log
storage/framework/cache
storage/framework/sessions
storage/framework/views
storage/framework/testing
bootstrap/cache/*.php
database/database.sqlite
database/*.sqlite*
.env
.env.*
!.env.example
.phpunit.result.cache
.php-tmp
browser-screenshots
.superpowers
docs/superpowers
sfw
graphify-out
README.md
docs/DEPLOYING.md
